<mxfile host="app.diagrams.net" agent="copilot" version="24.7.0">
  <diagram id="overview-demo" name="Overview - Demo overlay">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Demo overlay — FastAPI Container App sits in front of the production Function API" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1320" height="30" as="geometry" />
        </mxCell>

        <mxCell id="user" value="End user&#10;/ browser" style="shape=mxgraph.azure2019.user;html=1;fontSize=12;align=center;verticalAlign=top;" vertex="1" parent="1">
