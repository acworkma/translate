        </mxCell>

        <mxCell id="demo" value="Container App&#10;(demo FastAPI)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=#005A9E;fontColor=#FFFFFF;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="440" y="400" width="200" height="80" as="geometry" />
        </mxCell>

        <mxCell id="funcapp" value="Function App&#10;(production API)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=#005A9E;fontColor=#FFFFFF;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="900" y="240" width="200" height="80" as="geometry" />
        </mxCell>

        <mxCell id="storage" value="Document Storage" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#50E6FF;strokeColor=#0078D4;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="900" y="400" width="200" height="80" as="geometry" />
        </mxCell>

        <mxCell id="kv" value="Key Vault" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=#005A9E;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="900" y="560" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="acr" value="ACR" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#F2F2F2;strokeColor=#666666;dashed=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="440" y="240" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="e1" value="login + SPA" style="endArrow=classic;html=1;fontSize=11;" edge="1" parent="1" source="user" target="demo">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="300" y="380" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e2" value="upload .docx" style="endArrow=classic;html=1;fontSize=11;" edge="1" parent="1" source="user" target="demo">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="poll status / download" style="endArrow=classic;html=1;fontSize=11;" edge="1" parent="1" source="user" target="demo">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="300" y="500" />
